#version 450
// gelu_tanh.comp — elementwise GELU (tanh approximation)
//   y = 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer X { float x_data[]; };
layout (binding = 1) writeonly buffer Y { float y_data[]; };

layout (push_constant) uniform Push {
    uint N;
} pc;

const float BETA = 0.7978845608028654;
const float KAPPA = 0.044715;
const float SQRT2 = 1.4142135623730951;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.N) return;
    float x = x_data[i];
    float inner = SQRT2 * (x * (BETA + KAPPA * x * x));
    y_data[i] = 0.5 * x * (1.0 + tanh(inner));
}
