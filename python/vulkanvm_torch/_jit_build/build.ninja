ninja_required_version = 1.3
cxx = cl

cflags = -DTORCH_EXTENSION_NAME=vulkanvm_torch -DTORCH_API_INCLUDE_EXTENSION_H -ID:\VulkanVM\include -ID:\VulkanVM\python\vulkanvm_torch -IC:\Users\mikeh\miniconda3\Lib\site-packages\torch\include -IC:\Users\mikeh\miniconda3\Lib\site-packages\torch\include\torch\csrc\api\include -IC:\Users\mikeh\miniconda3\Lib\site-packages\torch\include\TH -IC:\Users\mikeh\miniconda3\Lib\site-packages\torch\include\THC -IC:\Users\mikeh\miniconda3\Include -D_GLIBCXX_USE_CXX11_ABI=0 /MD /wd4819 /wd4251 /wd4244 /wd4267 /wd4275 /wd4018 /wd4190 /wd4624 /wd4067 /wd4068 /EHsc /std:c++17 /std:c++20 /EHsc /O2 -DVERSION_INFO=\"0.2.0\"
post_cflags = 
cuda_dlink_post_cflags = 
ldflags = /DLL c10.lib torch_cpu.lib torch.lib /LIBPATH:C:\Users\mikeh\miniconda3\Lib\site-packages\torch\lib torch_python.lib /LIBPATH:C:\Users\mikeh\miniconda3\libs

rule compile
  command = cl /showIncludes $cflags -c $in /Fo$out $post_cflags
  deps = msvc



rule link
  command = "C$:\Program Files\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x64/link.exe" $in /nologo $ldflags /out:$out

build vulkanvm_torch.o: compile D$:\VulkanVM\python\vulkanvm_torch\vulkanvm_torch.cpp
build vulkanvm_compute.o: compile D$:\VulkanVM\python\vulkanvm_torch\vulkanvm_compute.cpp



build vulkanvm_torch.pyd: link vulkanvm_torch.o vulkanvm_compute.o

default vulkanvm_torch.pyd
